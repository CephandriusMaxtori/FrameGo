{
  "display": {
    "width": 800,
    "height": 480,
    "margin": 16,
    "gap": 8,
    "fps": 1,
    "background": "#0b0f14"
  },
  "admin": {
    "enabled": false,
    "bind": "0.0.0.0:8080",
    "token": ""
  },
  "modules": [
    {
      "name": "calendar",
      "zone": "lower-left",
      "visible": true,
      "options": {
        "url": "https://calendar.google.com/calendar/ical/YOUR_ID/basic.ics",
        "days": 3,
        "maxEvents": 5,
        "update": 3600
      }
    }
  ]
}
